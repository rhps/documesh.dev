// Documesh — Cloudflare Worker config (main product deployment)
//
// Production endpoints:
//   production → documesh-api → https://documesh.selatan.org
//   production → documesh-api → https://documesh.dev (+ www)
//
// Deploy commands:
//   npx wrangler deploy
//
// Prerequisite: zones (selatan.org and documesh.dev) exist in this
// Cloudflare account — CF creates DNS records + SSL certs automatically.
{
  "name": "documesh-api",
  "main": "worker/src/index.js",
  "compatibility_date": "2026-08-01",
  "assets": {
    "binding": "ASSETS",
    "directory": "./app",
    "run_worker_first": true
  },
  "routes": [
    { "pattern": "documesh.selatan.org", "custom_domain": true },
    { "pattern": "documesh.dev", "custom_domain": true },
    { "pattern": "www.documesh.dev", "custom_domain": true }
  ],
  "env": {
    "staging": {
      "name": "documesh-api-staging",
      "assets": {
        "binding": "ASSETS",
        "directory": "./app",
        "run_worker_first": true
      },
      "routes": [
        { "pattern": "documesh-beta.selatan.org", "custom_domain": true }
      ]
    },
    "production": {
      "name": "documesh-api",
      "assets": {
        "binding": "ASSETS",
        "directory": "./app",
        "run_worker_first": true
      },
      "routes": [
        { "pattern": "documesh.selatan.org", "custom_domain": true },
        { "pattern": "documesh.dev", "custom_domain": true },
        { "pattern": "www.documesh.dev", "custom_domain": true }
      ]
    }
  }
}
