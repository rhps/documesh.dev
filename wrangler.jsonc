// Documesh — Cloudflare Worker config
//
// documesh.selatan.org is THE deployment. Merge to main → "Deploy Staging"
// workflow deploys it immediately. Promotion to production is a separate
// tagged run ("Deploy Production" workflow, trigger: v* tag or manual).
//
// Environments:
//   staging    → documesh-api-staging → https://documesh.selatan.org
//   production → documesh-api         → https://documesh.selatan.org
//                documesh.dev (+ www)
//
// Both envs share the same custom domain: staging keeps the site live on
// every merge; production is the tagged promotion of the same code.
{
  "name": "documesh-api",
  "main": "worker/src/index.js",
  "compatibility_date": "2026-08-01",
  "assets": {
    "binding": "ASSETS",
    "directory": "./app",
    "run_worker_first": true
  },
  "env": {
    "staging": {
      "name": "documesh-api",
      "assets": {
        "binding": "ASSETS",
        "directory": "./app",
        "run_worker_first": true
      },
      "routes": [
        { "pattern": "documesh.selatan.org", "custom_domain": true }
      ]
    },
    "production": {
      "name": "documesh-api-prod",
      "assets": {
        "binding": "ASSETS",
        "directory": "./app",
        "run_worker_first": true
      },
      "routes": [
        { "pattern": "documesh.selatan.org", "custom_domain": true },
        { "pattern": "documesh.dev", "custom_domain": true },
        { "pattern": "www.documesh.dev", "custom_domain": true }
      ]
    }
  }
}
